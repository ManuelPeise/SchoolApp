<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Web.App.ViewComponents.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root"
    IsVisible="{Binding IsLoading}">

    <Grid
        BackgroundColor="{StaticResource OverLayBackground}"  
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <ActivityIndicator 
            IsRunning="True"
            Color="{StaticResource ColorOrange}"
            WidthRequest="{OnPlatform WinUI=200, Android=100}"
            HeightRequest="{OnPlatform WinUI=200, Android=100}"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>
    </Grid>
</ContentView>

