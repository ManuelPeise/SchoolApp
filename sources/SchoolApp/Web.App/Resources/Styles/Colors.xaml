<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  These colors are REPLACED by each theme  -->
    <Color x:Key="PrimaryColor">#000000</Color>
    <Color x:Key="PrimaryColorVariant">#000000</Color>
    <Color x:Key="SecondaryColor">#000000</Color>

    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <Color x:Key="TextPrimaryColor">#000000</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>

    <Color x:Key="DividerColor">#CCCCCC</Color>

    <Color x:Key="SuccessColor">#3CB371</Color>
    <Color x:Key="ErrorColor">#E53935</Color>

    <Color x:Key="InputDisabledColor">#cccccc</Color>
    <Color x:Key="InputDisabledTextColor">#666666</Color>
    <Color x:Key="ButtonBlue">#4d4dff</Color>
    <Color x:Key="LoadingColor">#ff6600</Color>

    <!--  Brushes bound dynamically to theme colors  -->
    <SolidColorBrush x:Key="AppPrimaryColor" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="AppPrimaryVariantColor" Color="{DynamicResource PrimaryColorVariant}" />
    <SolidColorBrush x:Key="AppSecondaryColor" Color="{DynamicResource SecondaryColor}" />

    <SolidColorBrush x:Key="AppBackgroundColor" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="AppSurfaceColor" Color="{DynamicResource SurfaceColor}" />

    <SolidColorBrush x:Key="AppTextPrimaryColor" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="AppTextSecondaryColor" Color="{DynamicResource TextSecondaryColor}" />

    <SolidColorBrush x:Key="AppDividerColor" Color="{DynamicResource DividerColor}" />

    <SolidColorBrush x:Key="AppSuccessColor" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="AppErrorColor" Color="{DynamicResource ErrorColor}" />

</ResourceDictionary>
