<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Web.App.Resources.Themes.DarkTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="PrimaryColor">#90CAF9</Color>
    <Color x:Key="PrimaryColorVariant">#64B5F6</Color>
    <Color x:Key="SecondaryColor">#26C6DA</Color>

    <Color x:Key="BackgroundColor">#0D1B2A</Color>
    <Color x:Key="SurfaceColor">#1B263B</Color>

    <Color x:Key="TextPrimaryColor">#EAF4F4</Color>
    <Color x:Key="TextSecondaryColor">#B4C4CC</Color>

    <Color x:Key="DividerColor">#2E3B4E</Color>

    <Color x:Key="SuccessColor">#81C784</Color>
    <Color x:Key="ErrorColor">#EF5350</Color>
</ResourceDictionary>