<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Web.App.Resources.Themes.DarkTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Modern Dark Theme - Semantic Tokens  -->

    <!--  Backgrounds / Surfaces  -->
    <Color x:Key="BackgroundPrimary">#0B1220</Color>
    <Color x:Key="BackgroundSecondary">#0F1724</Color>
    <Color x:Key="BackgroundDisabled">#e6e6e6</Color>
    <!--  Elevation / Borders  -->
    <Color x:Key="BorderPrimary">#1E3A8A</Color>
    <Color x:Key="BorderSecondary">#374151</Color>

    <!--  Primary / Accent (darker for better contrast on dark surfaces)  -->
    <Color x:Key="ColorAccent">#1D4ED8</Color>

    <!--  Buttons  -->
    <Color x:Key="ButtonBlue">#1D4ED8</Color>
    <Color x:Key="ButtonFont">#ffffff</Color>

    <!--  Text colors  -->
    <Color x:Key="FontDisabled">#6B7280</Color>
    <Color x:Key="FontPrimary">#E6EEF8</Color>
    <Color x:Key="FontSecondary">#94A3B8</Color>

    <!--  Semantic status colors  -->
    <Color x:Key="ColorSuccess">#34D399</Color>
    <Color x:Key="ColorWarning">#FBBF24</Color>
    <Color x:Key="ColorError">#F87171</Color>

    <!--  Accessibility helpers  -->
    <Color x:Key="ColorOverlay">#000000</Color>

    <!--  Example Styles referencing semantic tokens  -->
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundPrimary}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBorder}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FontPrimary}" />
    </Style>

</ResourceDictionary>
