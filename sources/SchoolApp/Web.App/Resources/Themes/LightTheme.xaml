<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Web.App.Resources.Themes.LightTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Modern Light Theme - Semantic Tokens  -->

    <!--  Backgrounds / Surfaces  -->
    <Color x:Key="BackgroundPrimary">#F6F8FA</Color> 
    <!--  page background  -->
    <Color x:Key="BackgroundSecondary">#F0F3F6</Color>
    <Color x:Key="BackgroundDisabled">#0F1724</Color>
    <!--<Color x:Key="ColorBackground">#F6F8FA</Color>-->
    <!--<Color x:Key="ColorSurface">#FFFFFF</Color> -->
    <!--  cards, panels  -->
    <!--
    <Color x:Key="ColorSurfaceAlt">#F7FAFC</Color>-->

    <!--  Elevation / Borders  -->
    <Color x:Key="ColorBorder">#E6EDF3</Color>
    <Color x:Key="BorderPrimary">#DCECFD</Color>
    <Color x:Key="BorderSecondary">#EAF2FA</Color>

    <!--  Primary / Accent  -->
    <Color x:Key="ColorAccent">#2563EB</Color> 
    <!--  blue-600  -->

    <!--  Buttons  -->
    <Color x:Key="ButtonBlue">#2563EB</Color>
    <Color x:Key="ButtonFont">#FFFFFF</Color>

    <!--  Text colors  -->
    <Color x:Key="ColorTextPrimary">#0F1724</Color>
    <Color x:Key="ColorTextSecondary">#475569</Color>
    <Color x:Key="ColorTextDisabled">#94A3B8</Color>
    <Color x:Key="FontPrimary">#0F1724</Color>
    <Color x:Key="FontSecondary">#475569</Color>

    <!--  Semantic status colors  -->
    <Color x:Key="ColorSuccess">#16A34A</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorError">#EF4444</Color>

    <!--  Accessibility helpers  -->
    <Color x:Key="ColorOverlay">#0B1120</Color>

    <!--  Example Styles referencing semantic tokens  -->
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundPrimary}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource ColorBorder}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FontPrimary}" />
    </Style>

</ResourceDictionary>
