<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Web.App.Resources.Themes.LightTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="PrimaryColor">#1E88E5</Color>
    <Color x:Key="PrimaryColorVariant">#1565C0</Color>
    <Color x:Key="SecondaryColor">#26C6DA</Color>

    <Color x:Key="BackgroundColor">#F5F9FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <Color x:Key="TextPrimaryColor">#0D1B2A</Color>
    <Color x:Key="TextSecondaryColor">#4A6572</Color>

    <Color x:Key="DividerColor">#D8E2EB</Color>

    <Color x:Key="SuccessColor">#43A047</Color>
    <Color x:Key="ErrorColor">#E53935</Color>
</ResourceDictionary>