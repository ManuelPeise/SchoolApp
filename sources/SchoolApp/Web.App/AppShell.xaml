<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Web.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Web.App"
    xmlns:auth="clr-namespace:Web.App.Views.Authentication"
    Title="School App">

    <Shell.FlyoutHeader>
        <Grid Padding="20">
            <Label Text="My App"
                   FontSize="24"
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Side menu pages -->
    <FlyoutItem Title="Home" Route="home">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Authentication" Route="auth">
        <ShellContent ContentTemplate="{DataTemplate auth:AuthenticationPage}" />
    </FlyoutItem>
</Shell>
