<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Web.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Web.App"
    xmlns:auth="clr-namespace:Web.App.Views.Authentication"
    Shell.NavBarHasShadow="False"
    Shell.BackgroundColor="Transparent"
    Shell.NavBarIsVisible="False"
    xmlns:vm="clr-namespace:Logic.Shared.ViewModels;assembly=Logic.Shared"
    Title="School App">

    <!-- Side menu pages -->
    <FlyoutItem Title="Home" Route="home">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Login" Route="login" FlyoutDisplayOptions="AsSingleItem">
        <ShellContent 
            Title="Login"
            Route="login"
            ContentTemplate="{DataTemplate auth:AuthenticationPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Register" Route="register" FlyoutDisplayOptions="AsSingleItem">
        <ShellContent
            Title="Register"
            Route="register"
            ContentTemplate="{DataTemplate auth:RegisterPage}" />
    </FlyoutItem>
    <!-- pages without flyout item-->
</Shell>
