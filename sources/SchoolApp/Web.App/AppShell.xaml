<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Web.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Web.App"
    xmlns:auth="clr-namespace:Web.App.Views.Authentication"
    xmlns:admin="clr-namespace:Web.App.Views.Administration"
    xmlns:vm="clr-namespace:Logic.Shared.ViewModels;assembly=Logic.Shared"
    Title="School App">

    <ShellContent
        Title="LoadingPage"
        Route="loading"
        Shell.NavBarIsVisible="False"
        Shell.NavBarHasShadow="False"
        Shell.FlyoutBehavior="Disabled"
        ContentTemplate="{DataTemplate auth:LoadingPage}"/>

    <ShellContent 
       Title="AuthenticationPage"
       Route="auth"
       Shell.NavBarIsVisible="False"
       Shell.NavBarHasShadow="False"
       ContentTemplate="{DataTemplate auth:AuthenticationPage}" />

    <ShellContent 
        Title="MainPage"
        Route="home"
        ContentTemplate="{DataTemplate local:MainPage}" />
    
    <ShellContent 
        Title="JSON-Datei Import"
        Route="jsonImportAssistent"
        Shell.NavBarIsVisible="False"
        Shell.NavBarHasShadow="False"
        ContentTemplate="{DataTemplate admin:JsonImportAssistentPage}" />
</Shell>
