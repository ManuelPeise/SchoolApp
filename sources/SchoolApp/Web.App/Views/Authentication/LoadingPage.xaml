<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Web.App.Views.Authentication.LoadingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Web.App.ViewComponents"
    Title="LoadingPage"
    BackgroundColor="{DynamicResource BackgroundPrimary}">
    <VerticalStackLayout Padding="30" Spacing="20">
        <Image
            Aspect="AspectFit"
            HeightRequest="140"
            SemanticProperties.Description="dot net bot in a hovercraft number nine"
            Source="dotnet_bot.png"
            WidthRequest="400" />
        <BoxView HeightRequest="10" HorizontalOptions="Center" />
        <controls:LoadingOverlay IsLoading="True" />
        <BoxView HeightRequest="10" HorizontalOptions="Center" />
        <Label
            Margin="0,20,0,0"
            FontSize="18"
            Text="Loading..." />
    </VerticalStackLayout>
</ContentPage>