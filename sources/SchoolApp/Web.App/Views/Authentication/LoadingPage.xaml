<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Web.App.Views.Authentication.LoadingPage"
             xmlns:controls="clr-namespace:Web.App.ViewComponents"
             Title="LoadingPage"
             BackgroundColor="Azure">
    <VerticalStackLayout Padding="30" Spacing="20">
        <Image
          Source="dotnet_bot.png"
          HeightRequest="140"
          WidthRequest="400"
          Aspect="AspectFit"
          SemanticProperties.Description="dot net bot in a hovercraft number nine" />
        <BoxView HorizontalOptions="Center" HeightRequest="10"/>
        <controls:LoadingOverlay IsLoading="True" />
        <BoxView HorizontalOptions="Center" HeightRequest="10"/>
        <Label Text="Loading..." FontSize="18" Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>