<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Web.App.Views.Authentication.AuthenticationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Web.App.ViewComponents"
    Style="{StaticResource DefaultContentPageStyle}">

    <Grid RowDefinitions="*,Auto,*">

        <Border
            Grid.Row="1"
            Padding="30"
            BackgroundColor="{DynamicResource AppSurfaceColor}"
            HorizontalOptions="Center"
            MinimumWidthRequest="{OnPlatform WinUI=420,
                                             Android=350}"
            StrokeThickness="0"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="26">

                <VerticalStackLayout Spacing="26">
                    <Image
                        Aspect="AspectFit"
                        Source="user_account.png"
                        Style="{StaticResource HeaderIcon}" />

                    <Label
                        HorizontalOptions="Center"
                        Style="{StaticResource H1}"
                        Text="Anmeldung"
                        TextColor="{DynamicResource AppTextPrimaryColor}" />
                </VerticalStackLayout>

                <controls:LabeledBorderlessEntry Label="Benutzername" Text="{Binding UserName}" />

                <controls:LabeledBorderlessEntry
                    IsPassword="True"
                    Label="Passwort"
                    Text="{Binding Password}" />

                <Button
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding CanLogin}"
                    Style="{StaticResource DefaultButton}"
                    Text="Anmelden" />

            </VerticalStackLayout>
        </Border>

        <controls:LoadingOverlay BackgroundColor="Transparent" IsLoading="{Binding IsLoading}" />
    </Grid>

</ContentPage>



