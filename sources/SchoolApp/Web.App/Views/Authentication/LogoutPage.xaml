<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Web.App.Views.Authentication.LogoutPage"
             BackgroundColor="{StaticResource ColorBackground}"
             Title="LogoutPage">
    <Grid
        RowDefinitions="*,Auto,*"
        ColumnDefinitions="*,Auto,*">

        <!-- Center container -->
        <Grid Grid.Row="1" Grid.Column="1">

            <Border
    Grid.Row="1"
    Grid.Column="1"
    Padding="0"
    StrokeThickness="0"
    BackgroundColor="{StaticResource ColorSurface}"
    StrokeShape="RoundRectangle 20">
                <!-- Card container (dark surface) -->
                <Grid
                BackgroundColor="{StaticResource ColorSurface}"
                Padding="30"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="{OnIdiom Phone=350, Tablet=400, Desktop=600}">

                    <Grid>
                        <VerticalStackLayout Spacing="30">
                            <Image
                                Source="log_out.png"
                                HeightRequest="140"
                                WidthRequest="400"
                                Aspect="AspectFit" />
                            <Label
                                Text="{Binding LogoutText}"
                                FontSize="28"
                                HorizontalOptions="Center"
                                TextColor="{StaticResource ColorTextPrimary}" />
                            <!-- Buttons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

                                <Button
                                    Text="Nein"
                                    Command="{Binding NavigateToHomeCommand}"
                                    BackgroundColor="{StaticResource ColorAccent}"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    FontSize="{OnPlatform WinUI=20, Android=14}"
                                    Grid.Column="0" />

                                <Button
                                    Text="Ja"
                                    Command="{Binding LogoutCommand}"
                                    BackgroundColor="{StaticResource ColorAccent}"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    FontSize="{OnPlatform WinUI=20, Android=14}"
                                    Grid.Column="1" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>