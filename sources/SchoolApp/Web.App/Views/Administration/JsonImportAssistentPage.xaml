<ContentPage
    x:Class="Web.App.Views.Administration.JsonImportAssistentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Web.App.ViewComponents"
    Title="JSON-Import"
    BackgroundColor="{DynamicResource BackgroundPrimary}">

    <!--  Root Grid with overlay for click-away  -->
    <Grid>
        <!--  Main content  -->
        <Grid
            Padding="20"
            ColumnDefinitions="*"
            RowDefinitions="Auto,*,Auto,Auto"
            RowSpacing="12">
            <!--  Row 0: Title  -->
            <Label
                Grid.Row="0"
                FontSize="{OnPlatform WinUI=26,
                                      Android=14}"
                HorizontalOptions="Center"
                Text="{Binding Title}"
                TextColor="{DynamicResource FontPrimary}" />
            <BoxView HeightRequest="60" />
            <!--  Row 1: CollectionView (scrolls automatically)  -->
            <CollectionView
                Grid.Row="1"
                BackgroundColor="{DynamicResource BackgroundSecondary}"
                HorizontalOptions="Fill"
                ItemsSource="{Binding ImportItems}"
                SelectedItem="{Binding SelectedItem}"
                SelectionChangedCommand="{Binding OnSelectionChangedCommand}"
                SelectionMode="Single"
                VerticalOptions="Fill">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Margin="5">

                            <Border
                                Padding="14"
                                Stroke="{DynamicResource BorderPrimary}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">

                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#3A3A3A" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Border"
                                        Value="False">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource BorderSecondary}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout>
                                    <Label
                                        FontAttributes="Bold"
                                        Style="{StaticResource DefaultLabel}"
                                        Text="{Binding Label}"
                                        TextColor="{DynamicResource FontSecondary}" />

                                    <BoxView BackgroundColor="Transparent" HeightRequest="2" />

                                    <Label
                                        FontAttributes="Italic"
                                        Style="{StaticResource DefaultLabel}"
                                        Text="{Binding Description}"
                                        TextColor="{DynamicResource FontPrimary}" />
                                </VerticalStackLayout>

                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Row 2: Status message  -->
            <Label
                Grid.Row="2"
                HorizontalOptions="Center"
                Style="{StaticResource DefaultLabel}"
                Text="{Binding StatusMessage}"
                TextColor="{DynamicResource FontPrimary}" />
            <!--  Row 3: Button pinned at bottom  -->
            <Button
                Grid.Row="3"
                Margin="0,8,0,0"
                Command="{Binding PickFileCommand}"
                HorizontalOptions="Fill"
                IsEnabled="{Binding CanImportFile}"
                Style="{DynamicResource ButtonStyle}"
                Text="Datei importieren" />

        </Grid>

        <!--  LoadingOverlay deckt die ganze Seite ab  -->
        <controls:LoadingOverlay
            Grid.Row="0"
            Grid.RowSpan="4"
            HorizontalOptions="Fill"
            IsLoading="{Binding IsLoading}"
            VerticalOptions="Fill" />

    </Grid>
</ContentPage>

