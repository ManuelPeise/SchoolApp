<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Web.App.Views.Administration.JsonImportAssistentPage"
             xmlns:controls="clr-namespace:Web.App.ViewComponents"
             BackgroundColor="{StaticResource ColorBackground}"
             Title="JSON-Import">

    <!-- Root Grid with overlay for click-away -->
    <Grid>
        <!-- Main content -->
        <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*" Padding="20" RowSpacing="12">
            <!-- Row 0: Title -->
            <Label Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="{OnPlatform WinUI=26, Android=14}"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource ColorTextPrimary}" />
            <BoxView HeightRequest="60"/>
            <!-- Row 1: CollectionView (scrolls automatically) -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding ImportItems}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedItem}"
                            SelectionChangedCommand="{Binding OnSelectionChangedCommand}"
                            BackgroundColor="{StaticResource ColorBackground}"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Margin="5">

                            <Border Stroke="{StaticResource ColorBorder}"
                                    StrokeThickness="1"
                                    Padding="14"
                                    StrokeShape="RoundRectangle 10">

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="#3A3A3A" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout>
                                    <Label Text="{Binding Label}"
                                           TextColor="{StaticResource ColorTextPrimary}"
                                           FontAttributes="Bold" />

                                    <BoxView HeightRequest="2" BackgroundColor="Transparent" />

                                    <Label Text="{Binding Description}"
                                           TextColor="{StaticResource ColorTextSecondary}"
                                           FontAttributes="Italic" />
                                </VerticalStackLayout>

                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Row 2: Status message -->
            <Label Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource ColorTextSecondary}" />
            <!-- Row 3: Button pinned at bottom -->
            <Button Grid.Row="3"
                    Text="Datei importieren"
                    Command="{Binding PickFileCommand}"
                    CornerRadius="8"
                    HorizontalOptions="Fill"
                    Margin="0,8,0,0"
                    IsEnabled="{Binding CanImportFile}"
                    BackgroundColor="{StaticResource ColorAccent}"
                    TextColor="{StaticResource ColorTextPrimary}" />

        </Grid>

        <!-- LoadingOverlay deckt die ganze Seite ab -->
        <controls:LoadingOverlay Grid.Row="0"
                                 Grid.RowSpan="4"
                                 IsLoading="{Binding IsLoading}"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill" />

    </Grid>
</ContentPage>

