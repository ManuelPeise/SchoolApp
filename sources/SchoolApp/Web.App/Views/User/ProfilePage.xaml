<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Web.App.Views.User.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Web.App.ViewComponents"
    xmlns:converters="clr-namespace:Web.App.Converters"
    Title="Profile"
    BackgroundColor="{StaticResource ColorBackground}">
    <ContentPage.Resources>
        <converters:DateTimeToStringConverter x:Key="dateConverter" />
        <converters:InvertBoolConverter x:Key="invertBoolConverter" />
    </ContentPage.Resources>
    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="*,Auto,*">

        <Grid Grid.Row="1" Grid.Column="1">

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="0"
                BackgroundColor="{StaticResource ColorSurface}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                <Grid
                    Padding="30"
                    BackgroundColor="{StaticResource ColorSurface}"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="{OnPlatform WinUI=600,
                                                     Android=350}"
                    VerticalOptions="Center">
                    <Grid RowSpacing="0">
                        <VerticalStackLayout Spacing="10">
                            <!--  TODO SET PROFILE IMAGE  -->
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="140"
                                Source="dotnet_bot.png"
                                WidthRequest="400" />

                            <Grid
                                Padding="10,0"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="0"
                                MaximumWidthRequest="{OnPlatform WinUI=600,
                                                                 Android=350}">

                                <Label
                                    Grid.Column="0"
                                    FontSize="{OnPlatform WinUI=24,
                                                          Android=14}"
                                    Text="Profil"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    VerticalOptions="Center" />

                                <ImageButton
                                    Grid.Column="1"
                                    Aspect="AspectFit"
                                    BackgroundColor="Transparent"
                                    Command="{Binding ToggleModeCommand}"
                                    HeightRequest="30"
                                    HorizontalOptions="End"
                                    Source="{Binding ToggleButtonImage}"
                                    WidthRequest="30" />
                            </Grid>

                            <controls:LabeledBorderlessEntry
                                Margin="0"
                                FontSize="{OnPlatform WinUI=16,
                                                      Android=12}"
                                IsEnabled="{Binding IsEditMode}"
                                Label="Vorname"
                                Placeholder="Vorname"
                                Text="{Binding User.FirstName}" />

                            <controls:LabeledBorderlessEntry
                                Margin="0"
                                FontSize="{OnPlatform WinUI=16,
                                                      Android=12}"
                                IsEnabled="{Binding IsEditMode}"
                                Label="Name"
                                Placeholder="Name"
                                Text="{Binding User.LastName}" />

                            <controls:LabeledBorderlessEntry
                                Margin="0"
                                FontSize="{OnPlatform WinUI=16,
                                                      Android=12}"
                                IsEnabled="False"
                                Label="Benutzername"
                                Placeholder="Benutzername"
                                Text="{Binding User.UserName}" />

                            <controls:LabeledBorderlessEntry
                                Margin="0"
                                FontSize="{OnPlatform WinUI=16,
                                                      Android=12}"
                                IsEnabled="False"
                                Label="Geburtsdatum"
                                Placeholder="Benutzername"
                                Text="{Binding User.DateOfBirth, Converter={StaticResource dateConverter}}" />

                            <Grid
                                Padding="10,15,0,15"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="20">
                                <Button
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource ColorAccent}"
                                    Command="{Binding NavigateToChangePasswordCommand}"
                                    FontSize="{OnPlatform WinUI=16,
                                                          Android=12}"
                                    IsEnabled="True"
                                    IsVisible="True"
                                    Text="Passwort Ändern"
                                    TextColor="{StaticResource ColorTextPrimary}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
                                <Grid
                                    Grid.Column="0"
                                    Padding="0"
                                    ColumnDefinitions="30, 150">
                                    <CheckBox
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        IsChecked="{Binding IsUser}"
                                        IsEnabled="False"
                                        VerticalOptions="Center"
                                        Color="{StaticResource ColorAccentDark}" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Text="User"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Grid
                                    Grid.Column="1"
                                    Padding="0"
                                    ColumnDefinitions="30, 150">
                                    <CheckBox
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        IsChecked="{Binding IsAdminUser}"
                                        IsEnabled="False"
                                        VerticalOptions="Center"
                                        Color="{StaticResource ColorAccentDark}" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Text="Admin"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Grid
                                    Grid.Column="2"
                                    Padding="0"
                                    ColumnDefinitions="30, 150">
                                    <CheckBox
                                        Grid.Column="0"
                                        HorizontalOptions="Center"
                                        IsChecked="{Binding IsSystemAdminUser}"
                                        IsEnabled="False"
                                        VerticalOptions="Center"
                                        Color="{StaticResource ColorAccentDark}" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Text="System Admin"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>

                            <Label
                                Margin="5,15,0,0"
                                FontAttributes="Italic"
                                FontSize="{OnPlatform WinUI=16,
                                                      Android=12}"
                                Text="{Binding LastUpdateText}"
                                TextColor="{StaticResource ColorTextPrimary}" />
                            <Grid
                                Margin="0,15,0,0"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="0">
                                <Grid
                                    Grid.Column="0"
                                    Padding="0"
                                    ColumnDefinitions="30,250">
                                    <CheckBox
                                        Grid.Column="0"
                                        HorizontalOptions="Start"
                                        IsChecked="{Binding IsSyncOnSave}"
                                        IsEnabled="{Binding IsEditMode}"
                                        Color="{StaticResource ColorAccentDark}" />
                                    <Label
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        FontSize="{OnPlatform WinUI=16,
                                                              Android=12}"
                                        Text="Bei Speichern synchronisieren"
                                        VerticalOptions="Center" />
                                </Grid>

                                <!--  optional manual sync button in the middle  -->
                                <Button
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource ColorAccent}"
                                    Command="{Binding SyncNowCommand}"
                                    FontSize="{OnPlatform WinUI=16,
                                                          Android=12}"
                                    IsEnabled="{Binding IsSyncOnSave, Converter={StaticResource invertBoolConverter}}"
                                    Text="Jetzt synchronisieren" />

                                <!--  Save / Cancel buttons remain, or keep them in column 2 as currently  -->
                            </Grid>
                            <Grid
                                Margin="0,25,0,0"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="20">
                                <Button
                                    Grid.Column="0"
                                    BackgroundColor="{StaticResource ColorAccent}"
                                    Command="{Binding RevertChangesCommand}"
                                    FontSize="{OnPlatform WinUI=16,
                                                          Android=12}"
                                    IsEnabled="{Binding IsModified}"
                                    IsVisible="True"
                                    Text="Abbrechen"
                                    TextColor="{StaticResource ColorTextPrimary}" />

                                <Button
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource ColorAccent}"
                                    Command="{Binding SaveChangesCommand}"
                                    FontSize="{OnPlatform WinUI=16,
                                                          Android=12}"
                                    IsEnabled="{Binding IsModified}"
                                    IsVisible="True"
                                    Text="Speichern"
                                    TextColor="{StaticResource ColorTextPrimary}" />
                            </Grid>


                        </VerticalStackLayout>
                        <controls:LoadingOverlay
                            HorizontalOptions="Fill"
                            IsLoading="{Binding IsLoading}"
                            VerticalOptions="Fill" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>