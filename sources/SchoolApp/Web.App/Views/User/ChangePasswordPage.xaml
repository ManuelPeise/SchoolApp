<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Web.App.Views.User.ChangePasswordPage"
             xmlns:controls="clr-namespace:Web.App.ViewComponents"
             xmlns:converters="clr-namespace:Web.App.Converters"
             BackgroundColor="{StaticResource ColorBackground}"
             Title="ChangePasswordPage">
    <ContentPage.Resources>
        <converters:InvertBoolConverter x:Key="invertBoolConverter" />
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto,*"
       ColumnDefinitions="*,Auto,*">
        <Grid Grid.Row="1" Grid.Column="1">
            <Border Grid.Row="1"
             Grid.Column="1"
             Padding="0"
             StrokeThickness="0"
             BackgroundColor="{StaticResource ColorSurface}"
             StrokeShape="RoundRectangle 20">
                <Grid BackgroundColor="{StaticResource ColorSurface}"
                   Padding="30"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MaximumWidthRequest="{OnPlatform WinUI=600,Android=350}">
                    <Grid RowSpacing="0">
                        <VerticalStackLayout Spacing="10">
                            <!--TODO SET PROFILE IMAGE-->
                            <Image Source="dotnet_bot.png"
                                HeightRequest="140"
                                WidthRequest="400"
                                Aspect="AspectFit" />

                            <Grid ColumnDefinitions="Auto,*"
                               ColumnSpacing="0"
                               Padding="10,0"
                               MaximumWidthRequest="{OnPlatform WinUI=600,Android=350}">

                                <Label Grid.Column="0" 
                                    Text="Passwort Aktualisierung"
                                    FontSize="{OnPlatform WinUI=24,Android=14}"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    VerticalOptions="Center"/>


                            </Grid>
                            <controls:LabeledBorderlessEntry  Label="Aktuelles Passwort"
                                                              FontSize="{OnPlatform WinUI=16,Android=12}"
                                                              Placeholder="Aktuelles Passwort eingeben"
                                                              IsPassword="True"
                                                              IsEnabled="True"
                                                              Margin="0"  
                                                              Text="{Binding CurrentPassword}"
                                                              UnfocusedCommand="{Binding PasswordEntryUnfocusedCommand}"/>

                            <Label Text="{Binding ErrorMessage}"
                                   Padding="5,0"
                                   Margin="0"
                                   IsVisible="{Binding CurrentPasswordConfirmed, Converter={StaticResource invertBoolConverter}}"
                                   FontSize="{OnPlatform WinUI=16, Android=10}"
                                   TextColor="{StaticResource ColorError}"/>
                            
                            <controls:LabeledBorderlessEntry  Label="Neues Passwort"
                                                              FontSize="{OnPlatform WinUI=16,Android=12}"
                                                              Placeholder="Neues Passwort eingeben"
                                                              IsEnabled="{Binding CurrentPasswordConfirmed}"
                                                              IsPassword="True"
                                                              Margin="0"  
                                                              Text="{Binding NewPassword}"/>

                            <controls:LabeledBorderlessEntry  Label="Neues Passwort wiederholen"
                                                              FontSize="{OnPlatform WinUI=16,Android=12}"
                                                              Placeholder="Neues Passwort eingeben"
                                                              IsEnabled="{Binding CurrentPasswordConfirmed}"
                                                              IsPassword="True"
                                                              Margin="0"  
                                                              Text="{Binding NewPasswordReplication}"/>
                            
                            <Label Text="{Binding ErrorMessage}"
                                   Padding="5,0"
                                   Margin="0"
                                   IsVisible="{Binding PasswordChanged, Converter={StaticResource invertBoolConverter}}"
                                   FontSize="{OnPlatform WinUI=16, Android=10}"
                                   TextColor="{StaticResource ColorError}"/>
                            
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="20" Margin="0,25,0,0">
                                <Button Text="Abbrechen"
                                        Command="{Binding RevertChangesCommand}"
                                        IsVisible="True"
                                        IsEnabled="{Binding IsModified}"
                                        BackgroundColor="{StaticResource ColorAccent}"
                                        TextColor="{StaticResource ColorTextPrimary}"
                                        FontSize="{OnPlatform WinUI=20, Android=14}"
                                        Grid.Column="0" />
                                
                                <Button Text="Speichern"
                                        Command="{Binding ChangePasswordCommand}"
                                        IsVisible="True"
                                        IsEnabled="{Binding CanSave}"
                                        BackgroundColor="{StaticResource ColorAccent}"
                                        TextColor="{StaticResource ColorTextPrimary}"
                                        FontSize="{OnPlatform WinUI=20, Android=14}"
                                        Grid.Column="1" />
                            </Grid>

                        </VerticalStackLayout>
                        <controls:LoadingOverlay IsLoading="{Binding IsLoading}"
                                              HorizontalOptions="Fill"
                                              VerticalOptions="Fill" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>