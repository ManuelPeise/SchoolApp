<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Web.App.Views.Sync.DataSyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Web.App.ViewComponents"
    xmlns:converters="clr-namespace:Web.App.Converters"
    Title="ChangePasswordPage"
    BackgroundColor="{DynamicResource BackgroundPrimary}">
    <ContentPage.Resources>
        <converters:InvertBoolConverter x:Key="invertBoolConverter" />
    </ContentPage.Resources>
    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="*,Auto,*">
        <Grid Grid.Row="1" Grid.Column="1">
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="0"
                BackgroundColor="{DynamicResource BackgroundPrimary}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                <Grid
                    Padding="30"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="{OnPlatform WinUI=600,
                                                     Android=350}"
                    VerticalOptions="Center">
                    <Grid RowSpacing="0">
                        <VerticalStackLayout Spacing="10">
                            <!--  Image  -->
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="140"
                                Source="dotnet_bot.png"
                                WidthRequest="400" />

                            <Grid
                                Padding="10,0"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="0"
                                MaximumWidthRequest="{OnPlatform WinUI=600,
                                                                 Android=350}">

                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource Caption}"
                                    Text="Daten Synconisierung"
                                    VerticalOptions="Center" />
                            </Grid>
                            <!--  TODO ADD SYNC ITEMS  -->
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>