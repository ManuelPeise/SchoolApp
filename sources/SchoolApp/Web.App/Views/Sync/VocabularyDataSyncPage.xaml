<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Web.App.Views.Sync.VocabularyDataSyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Web.App.ViewComponents"
    xmlns:converters="clr-namespace:Web.App.Converters"
    Title="ChangePasswordPage"
    BackgroundColor="{StaticResource ColorBackground}">
    <ContentPage.Resources>
        <converters:InvertBoolConverter x:Key="invertBoolConverter" />
    </ContentPage.Resources>
    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="*,Auto,*">
        <Grid Grid.Row="1" Grid.Column="1">
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="0"
                BackgroundColor="{StaticResource ColorSurface}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                <Grid
                    Padding="30"
                    BackgroundColor="{StaticResource ColorSurface}"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="{OnPlatform WinUI=600,
                                                     Android=350}"
                    VerticalOptions="Center">
                    <Grid RowSpacing="0">
                        <VerticalStackLayout Spacing="10">
                            <!--  Image  -->
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="140"
                                Source="dotnet_bot.png"
                                WidthRequest="400" />

                            <Grid
                                Padding="10,0"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="0"
                                MaximumWidthRequest="{OnPlatform WinUI=600,
                                                                 Android=350}">

                                <Label
                                    Grid.Column="0"
                                    FontSize="{OnPlatform WinUI=24,
                                                          Android=14}"
                                    Text="Vokabel Daten Synconisierung"
                                    TextColor="{StaticResource ColorTextPrimary}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <!--  Sync Info  -->
                            <Grid
                                Padding="10"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="30"
                                RowDefinitions="*,*,*"
                                RowSpacing="20">
                                <!--  Last Sync  -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontSize="18"
                                    Text="Letzte Synchronisation am:" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontSize="16"
                                    HorizontalTextAlignment="Start"
                                    Text="20.04.2004"
                                    TextColor="Gray" />
                                <!--  By  -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="18"
                                    Text="Durch:" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="16"
                                    HorizontalTextAlignment="Start"
                                    Text="Papa"
                                    TextColor="Gray" />
                                <!--  Sync Button  -->
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    BackgroundColor="#6200EE"
                                    FontSize="18"
                                    Text="Jetzt synchronisieren"
                                    TextColor="White" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>