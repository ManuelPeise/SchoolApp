<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Web.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Web.App.Converters"
    xmlns:local="clr-namespace:Web.App">

    <Application.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <ResourceDictionary.MergedDictionaries>
                <!--  Load default theme first so component styles can reference tokens  -->
                <ResourceDictionary Source="/Resources/Themes/LightTheme.xaml" />

                <!--  Consolidated component styles -->
                <ResourceDictionary Source="/Resources/Styles/CustomStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
